<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smartboat_mission</name>
  <version>0.0.0</version>
  <description>Mission-level launch and orchestration files for the smart boat.</description>
  <maintainer email="ubuntu2204@todo.todo">ubuntu2204</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-pymavlink</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>smartboat_drivers</exec_depend>
  <exec_depend>smartboat_control</exec_depend>
  <exec_depend>smartboat_msgs</exec_depend>
  <exec_depend>smartboat_perception</exec_depend>
  <exec_depend>smartboat_navigation</exec_depend>
  <exec_depend>smartboat_px4_bridge</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
